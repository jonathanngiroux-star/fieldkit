{
  "title": "Onboarding feedback",
  "description": "Fixture: one branch, one required, one hidden",
  "questions": [
    {
      "id": "q1",
      "type": "single_choice",
      "title": "Did the onboarding flow work?",
      "required": true,
      "choices": ["yes", "no"]
    },
    {
      "id": "q2",
      "type": "text",
      "title": "What failed?",
      "hidden": true
    },
    {
      "id": "q3",
      "type": "text",
      "title": "Anything else?"
    }
  ],
  "logic": [
    {
      "id": "br1",
      "when": {"question": "q1", "op": "eq", "value": "no"},
      "then": {"action": "show", "question": "q2"}
    }
  ]
}
